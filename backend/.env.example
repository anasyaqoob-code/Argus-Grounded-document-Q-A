# -----------------------------------------------------------------------------
# Argus backend — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp backend/.env.example backend/.env
#   # then edit backend/.env
#
# NEVER commit `.env`. Only this template (.env.example) belongs in git,
# and it must contain placeholder values only.
# -----------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=Argus
DEBUG=false
API_PREFIX=/api/v1

# Set to "production" when running behind HTTPS (Railway, Fly, etc.).
# Controls the Secure flag on the session cookie.
ENV=development

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Used by password-reset email links and the Google OAuth redirect.
# In production this is your deployed frontend origin, e.g.
#   https://argus-frontend.up.railway.app
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT signing secret — required for authentication.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be unique per deployment. Never reuse across environments.
JWT_SECRET=

# First user with this email is auto-promoted to admin on registration.
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# LLM — Groq
# ---------------------------------------------------------------------------
# Get a key from https://console.groq.com/keys
# Leave blank to allow the app to start; the engine raises on first use.
GROQ_API_KEY=
# Optional: override if you proxy through a Groq-compatible gateway.
GROQ_BASE_URL=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Embeddings — HuggingFace (runs locally, no API key)
# ---------------------------------------------------------------------------
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Offline mode for HuggingFace models. Set to 1 once the embedding model
# is cached locally. Skips the network check on startup.
# Leave unset on a fresh deploy so the model downloads on first boot.
HF_HUB_OFFLINE=
TRANSFORMERS_OFFLINE=

# Optional — override the default vision model used by image Q&A.
# ARGUS_VISION_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
TOP_K=4
SCORE_THRESHOLD=0.0
DOC_RELEVANCE_FLOOR=0.05
MAX_CONTEXT_TOKENS=6000
MAX_RETRIEVAL_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Session / memory
# ---------------------------------------------------------------------------
SESSION_TTL_SECONDS=86400
MEMORY_MESSAGE_LIMIT=6

# ---------------------------------------------------------------------------
# Agent behaviour toggles
# ---------------------------------------------------------------------------
QUERY_REWRITING=true
ANSWER_VERIFICATION=true
SOURCE_CITATIONS=true

# ---------------------------------------------------------------------------
# Verification / abstention
# ---------------------------------------------------------------------------
MIN_CITATION_COVERAGE=0.6
ABSTAIN_CONFIDENCE_THRESHOLD=0.35

# ---------------------------------------------------------------------------
# Upload / validation
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_PAGES_PER_DOC=500
MAX_FILES_PER_BATCH=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# ---------------------------------------------------------------------------
# Storage (optional overrides — the app defaults to paths next to storage.py)
# ---------------------------------------------------------------------------
SQLITE_PATH=argus.db
CHROMA_PATH=./chroma_data

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud.
# Local:      http://localhost:8000/api/v1/auth/google/callback
# Production: https://<backend>.up.railway.app/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Password reset email — Resend
# ---------------------------------------------------------------------------
# Get a key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Test tier only allows onboarding@resend.dev.
# Verify a domain at https://resend.com/domains to send from your own.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Argus